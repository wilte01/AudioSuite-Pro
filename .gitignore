# Changed in 1.4.1: ignores the exported CLI payload directory (cli-payloads/),
# a CI build artifact regenerated with
# `python -m tests.cli_schema_conformance --export-dir cli-payloads`.
# Changed in 1.0.1: removed *.dll to allow discid.dll to be committed for CD Ripper.
# Changed in 1.0.1: modified to document the CI infrastructure fix.
# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
dist/
build/

# Virtual environments
.venv/
env/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
# Office/LibreOffice lock + owner files (created when a .docx/.pptx is opened
# or regenerated; must never be committed)
~$*
*.~lock.*#

# Cache
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.pyc

# OS
Thumbs.db
.DS_Store

# Project-specific
audio_suite_config.json
audio_suite_config.key
# suite_config sidecars: cross-process lock + PID-scoped atomic-write temp files
audio_suite_config.json.lock
audio_suite_config.json.tmp.*
# album_art_sync API-key files (live Fanart.tv keys — never commit; template lives on disk)
# Changed in 2.1.3: the config file is canonical at album_art_sync/config/ and
# save_config leaves an interrupted atomic write as this .tmp beside it.
album_art_config.json
album_art_config.key
album_art_config.json.tmp
# Backups written by KeyManager before it replaces an unusable key file.
# A glob, not two literal names, so every current and future tool's key
# backup is covered; these are secret-class like the keys themselves.
*.key.bak
*.spec
# CLI payloads uploaded as the CI `cli-payloads` artifact (one file per command).
cli-payloads/
.coverage
.coverage.*
htmlcov/
# Sphinx output (PLAN D98); the scaffold is committed, the rendered HTML is not.
docs/_build/
# Per-user pipeline state (PLAN D101). The live file belongs in ~/.audiosuite;
# a copy left in the checkout by an older version is read once, never tracked.
audio_refinery/refinery_settings.json
logs/
*.log
*.lnk
.env
.env.*
!.env.example
.junie/

# Agent harness state (a per-checkout project id, not project content).
.freebuff/
